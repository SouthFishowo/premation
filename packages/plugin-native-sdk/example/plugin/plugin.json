{
  "id": "studio.example.native-exposure",
  "name": "Example Native Exposure",
  "version": "1.0.0",
  "description": "One effect, rendered by a compiled addon when there is a binary for this machine and by JavaScript when there is not.",
  "apiVersion": 7,
  "main": "index.js",
  "permissions": [],
  "native": {
    "abi": 1,
    "platforms": {
      "win32-x64": "bin/win32-x64/motion_example.node",
      "darwin-arm64": "bin/darwin-arm64/motion_example.node",
      "darwin-x64": "bin/darwin-x64/motion_example.node",
      "linux-x64": "bin/linux-x64/motion_example.node"
    },
    "hashes": {
      "bin/win32-x64/motion_example.node": "<sha256, written by scripts/pack-plugin.mjs --native>"
    },
    "threadSafety": "full",
    "timeoutMs": 4000,
    "idleTimeoutMs": 60000
  },
  "contributes": {
    "effects": [
      {
        "id": "exposure",
        "label": "Exposure (native)",
        "threadSafety": "full",
        "cpu": { "module": "fallback.js", "entry": "render", "format": "js" },
        "params": {
          "stops": { "type": "number", "label": "Stops", "default": 0, "min": -8, "max": 8 }
        }
      }
    ]
  }
}
